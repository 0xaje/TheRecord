{
  "name": "the-record",
  "version": "1.0.0",
  "description": "Post-quantum agreement approvals and version-bound file verification on QoreChain Diana Testnet",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "esbuild web/verify.js --bundle --preserve-symlinks --platform=browser --format=esm --outfile=dist/verify.js && cp web/index.html dist/index.html",
    "build:site": "npm run build && node scripts/build-worker.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build:site && npm test",
    "start:local": "node scripts/serve-local.mjs",
    "package:site": "node scripts/package-site.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xaje/TheRecord.git"
  },
  "keywords": ["qorechain", "post-quantum", "agreement", "verification", "diana-testnet"],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/0xaje/TheRecord/issues"
  },
  "homepage": "https://github.com/0xaje/TheRecord#readme",
  "dependencies": {
    "@qorechain/evm": "0.14.0",
    "@qorechain/qoresign": "0.2.0",
    "cosmjs-types": "0.11.0",
    "viem": "2.57.19"
  },
  "devDependencies": {
    "@qorechain/sdk": "0.14.0",
    "esbuild": "0.28.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.3 <25"
  }
}
